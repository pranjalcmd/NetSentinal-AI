# NetSentinel AI — backend config
#
# Copy this file to .env (same folder) and fill in what you need.
# Nothing here is required: with no .env at all the backend runs fully, using
# mock AI explanations and the local detection engines.

# ---------------------------------------------------------------------------
# THE API KEY GOES HERE.
# ---------------------------------------------------------------------------
# Leave it empty -> /api/alerts/{id}/explain, /api/ai/ask and /api/ai/report
# return the mock analyst text. Paste a key -> the same endpoints call a real
# model instead. Nothing else changes; the response schema is identical either
# way, and every provider is normalized into it (PRD §45).
# Check which one is live: GET /api/health -> "ai_provider"
# A live call that fails (bad key, wrong model) falls back to mock and records
# why in "ai_last_error" — a wrong model name and a rejected key look the same
# without it.
AI_API_KEY=

# Provider adapter. mock | gemini | openai | anthropic  (§16.1).
# Leave unset: the model name below decides (gemini-* -> Gemini,
# claude-* -> Anthropic, anything else -> OpenAI-compatible).
# AI_PROVIDER=gemini

# Model used when AI_API_KEY is set. gemini-2.5-flash is retired for new keys.
AI_MODEL=gemini-3.6-flash

# Only for a gateway/proxy. Unset -> the provider's own public API.
# AI_API_URL=

# ---------------------------------------------------------------------------
# What leaves this process (PRD §46)
# ---------------------------------------------------------------------------
# Only normalized telemetry is ever sent: protocol, flow statistics, selected
# metadata, rule findings and nDPI risk names. Raw packet payloads, passwords,
# cookies, bearer tokens and authorization headers are dropped in code by
# `minimize()` in backend/app/services/ai_service.py, not merely discouraged in
# the prompt — so a caller passing them in cannot leak them. Model output is
# filtered the same way on the way back: certainty claims are reworded and
# block/isolate/remediate advice is dropped (§12 wording rule, §66 scope).

# ---------------------------------------------------------------------------
# Detection
# ---------------------------------------------------------------------------
# Trained classifier. Absent -> the engine falls back to its heuristic and
# /api/health reports "ml_trained_model": false. Build it with scripts/train.py.
# MODEL_PATH=./models/ndpi_detector.joblib

# Largest .pcap accepted by POST /api/analyze/pcap.
MAX_UPLOAD_MB=100

# ---------------------------------------------------------------------------
# Persistence (PRD §32)
# ---------------------------------------------------------------------------
# SQLite file holding analysis history. Created on first boot; nothing to
# install or migrate. A capture is written once when it finishes analysing, so
# GET /api/jobs survives a restart and POST /api/jobs/{id}/load reopens one.
# DATABASE_PATH=./netsentinel.db

# Captures kept in that file. The oldest are dropped past this, with their
# flows, alerts, findings and incidents — unbounded history is a disk leak.
# MAX_STORED_JOBS=50

# ---------------------------------------------------------------------------
# nDPI (these two are environment variables, not settings — see README)
# ---------------------------------------------------------------------------
# Path to a built ndpiReader binary. Set it and the DPI path becomes real
# deep packet inspection with nDPI protocol IDs and risk flags. Unset, the
# backend uses its pure-Python pcap reader and guesses protocol from the port.
# NDPI_READER=/path/to/nDPI/example/ndpiReader
# NDPI_ROOT=/path/to/nDPI
